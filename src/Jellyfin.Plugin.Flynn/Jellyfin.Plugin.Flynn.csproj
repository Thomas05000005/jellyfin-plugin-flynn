<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Jellyfin 12+ only. Jellyfin 12 runs on .NET 10 and its SDK packages ship net10.0 only. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.Flynn</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.Flynn</RootNamespace>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- A warning here is a bug that ships. Keep this true. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.Flynn.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- ExcludeAssets:runtime — the server provides these at runtime. Shipping them would put
         duplicate assemblies in the plugin folder. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-rc4">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.0.0-rc4">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
